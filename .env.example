# ─────────────────────────────────────────────────────────────
# GSI-EBD — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# ─────────────────────────────────────────────────────────────

# Banco de dados
DATABASE_URL=sqlite:///gsi_ebd.db
# Para produção (PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/gsi_ebd

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app_google
EMAIL_FROM=noreply@gsi-ebd.com.br
EMAIL_FROM_NAME=GSI-EBD Estudos Bíblicos

# URL base do app (usada nos links dos emails)
APP_BASE_URL=http://localhost:3000

# ─── Segurança / Autenticação ──────────────────────────────────
# Máximo de tentativas de login antes de suspender a conta
MAX_FAILED_LOGIN_ATTEMPTS=5

# Horas de validade do token de confirmação (email)
TOKEN_EXPIRY_HOURS=24

# Dias de inatividade antes de tornar usuário INATIVO
INACTIVITY_DAYS=60

# ─── IA (Ollama) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
