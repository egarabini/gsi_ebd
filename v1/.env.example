# Copie para .env na VPS. Nao grave segredo no repositorio.
# O banco tem de se chamar didasko_v1 (a v0 permanece no banco antigo).
POSTGRES_USER=didasko_v1
DATABASE_URL=postgresql+psycopg2://didasko_v1:troque@postgres-v1:5432/didasko_v1
# Minimo de 32 caracteres. So na VPS.
SESSION_SECRET=
# 1 na homologacao (cookie Secure). 0 so no teste local em HTTP.
COOKIE_SECURE=1
# A senha do seed fica no ambiente do script, nao neste arquivo
# e nao no environment: do Compose (A-2).
