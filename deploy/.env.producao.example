# Didasko — variaveis de producao (copie para .env na VPS e preencha)
# NAO versionar o .env preenchido.

# --- Dominio / TLS ---
# email que o Let's Encrypt usa para avisar sobre expiracao do certificado
ACME_EMAIL=seu-email@exemplo.com

# --- Banco de dados ---
POSTGRES_DB=didasko
POSTGRES_USER=didasko
# GERE UMA SENHA FORTE: openssl rand -base64 32
POSTGRES_PASSWORD=troque-por-senha-forte

# --- Aplicacao ---
# GERE UMA CHAVE FORTE: openssl rand -hex 32
SECRET_KEY=troque-por-chave-forte
APP_BASE_URL=https://didasko.app.br

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contato@didasko.app.br
EMAIL_FROM_NAME=Didasko

# --- Regras de acesso ---
MAX_FAILED_LOGIN_ATTEMPTS=5
TOKEN_EXPIRY_HOURS=24
INACTIVITY_DAYS=60
