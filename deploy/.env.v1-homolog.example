# Copie para .env na VPS, na raiz do clone da homologacao.
# Nao use /home/eduardo/didasko e nao aponte para o postgres da v0.
POSTGRES_USER=didasko
POSTGRES_PASSWORD=
POSTGRES_DB=didasko_v1
SESSION_SECRET=
# IP do Traefik na rede de borda (docker network inspect). Muda se o container recriar.
TRAEFIK_EDGE_IP=
# Rede do compose de producao ja em execucao. Nao crie outro Traefik.
BORDA_NETWORK=deploy_didasko
# So no ambiente do script (export), nunca no environment: do Compose.
SEED_PASSWORD=
